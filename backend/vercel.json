{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node scripts/build-static-frontend.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(health|docs(?:/.*)?|openapi\\.json|redoc(?:/.*)?)",
      "dest": "/api/index.py"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/favicon.svg"
    }
  ]
}
